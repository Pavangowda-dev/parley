{
  "name": "parley",
  "productName": "Parley",
  "version": "1.1.0",
  "description": "Parley — an AI companion that lives in the corner of your screen. Say \"Hey Aira\" (or any name you choose) and talk about anything: it remembers your day, reacts with real feelings, sets reminders and keeps you on track. Optional English coaching. Windows & macOS · runs locally · just add your OpenAI key.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "shortcut": "node scripts/shortcut.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "license": "MIT",
  "build": {
    "appId": "com.parley.app",
    "productName": "Parley",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Parley",
      "runAfterFinish": true
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/@picovoice/**"
    ],
    "artifactName": "Parley-Setup-${version}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Parley listens when you talk to your buddy, and for its name when the wake word is on.",
        "LSUIElement": false
      }
    },
    "dmg": {
      "title": "Parley ${version}",
      "artifactName": "Parley-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@picovoice/porcupine-node": "^4.0.2",
    "@picovoice/pvrecorder-node": "^1.2.9"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "keywords": [
    "english",
    "speaking-practice",
    "voice-assistant",
    "electron",
    "openai-realtime",
    "language-learning",
    "desktop-pet",
    "accountability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Pavangowda-dev/parley.git"
  },
  "homepage": "https://github.com/Pavangowda-dev/parley#readme"
}
