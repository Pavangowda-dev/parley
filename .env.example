# Parley: the only thing you need is an OpenAI API key.
# Get one at https://platform.openai.com/api-keys, paste it below and save this file as ".env".
# (Or skip this file and paste the key in the app: right-click the buddy → Settings.)
OPENAI_API_KEY=

